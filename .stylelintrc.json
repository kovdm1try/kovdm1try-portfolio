{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-order"],
  "rules": {
    "order/properties-alphabetical-order": true,
    "color-named": "never",
    "declaration-no-important": true,
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["theme"] }],
    "import-notation": null
  }
}
